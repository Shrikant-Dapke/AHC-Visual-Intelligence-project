# Copy to backend/.env for local overrides (never commit .env).
MAX_UPLOAD_MB=200
SAMPLE_FPS=1.0
CORS_ORIGINS=http://localhost:3000
MODEL_BACKEND=heuristic
# Unified CLIP+YOLO analysis (defaults shown; paths are relative or absolute).
# CLIP_MODEL_DIR must contain classifier.joblib + labels.json (written by
# scripts/train_clip_classifier.py). While training is still running the
# backend reports CLIP as unavailable and never fakes predictions.
CLIP_MODEL_DIR=models/clip_linear_v1
EVIDENCE_DIR=data/evidence
YOLO_ENABLED=true
YOLO_MODEL=yolov8n.pt
YOLO_CONF=0.35
YOLO_IMGSZ=640
YOLO_SAMPLE_FPS=2.0
YOLO_TRACKER=iou
YOLO_MAX_FRAMES=600
